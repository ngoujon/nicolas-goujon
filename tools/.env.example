# Copier ce fichier en .env et renseigner les valeurs :
#   cp tools/.env.example tools/.env
#
# tools/.env est ignoré par Git (ne jamais committer de secrets).

# --- Connexion SSH au VPS ---
VPS_HOST=VOTRE_IP_VPS
VPS_USER=votre-utilisateur
VPS_PORT=22
# Mettre entre quotes simples si le mot de passe contient des caractères spéciaux (ex. parenthèses)
VPS_PASSWORD=

# Utilisateur applicatif (git pull + deploy) si différent de VPS_USER
RUN_AS_USER=

# Chemin du dépôt sur le serveur (répertoire où deploy.sh est présent)
APP_DIR=/home/nicolas-goujon/nicolas-goujon

# Branche Git déployée
GIT_BRANCH=main

# --- GitHub depuis le serveur distant (git pull via SSH) ---
# Chemin de la clé SSH sur le VPS (deploy key ou clé personnelle)
GITHUB_SSH_KEY_PATH=/home/nicolas-goujon/.ssh/id_ed25519

# Passphrase de la clé SSH GitHub (laisser vide si la clé n'en a pas)
GITHUB_SSH_KEY_PASSPHRASE=
