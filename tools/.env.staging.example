# Environnement STAGING — copier en tools/.env.staging et renseigner les
# valeurs pour déployer sur le répertoire staging du VPS (distinct de la prod) :
#   cp tools/.env.staging.example tools/.env.staging
#
# Usage : UPDATE_ENV_FILE=.env.staging ./tools/update.sh
# tools/.env.staging est ignoré par Git (ne jamais committer de secrets).

# --- Connexion SSH au VPS (peut être le même VPS que la prod) ---
VPS_HOST=VOTRE_IP_VPS
VPS_USER=votre-utilisateur
VPS_PORT=22
VPS_PASSWORD=

# Utilisateur applicatif (git pull + deploy) si différent de VPS_USER
RUN_AS_USER=

# Chemin du dépôt STAGING sur le serveur — DOIT être différent du répertoire
# de production (ex: nicolas-goujon-staging vs nicolas-goujon)
APP_DIR=/home/nicolas-goujon/nicolas-goujon-staging

# Branche Git déployée en staging (ex: develop, staging), distincte de main
GIT_BRANCH=staging

# --- GitHub depuis le serveur distant (git pull via SSH) ---
GITHUB_SSH_KEY_PATH=/home/nicolas-goujon/.ssh/id_ed25519
GITHUB_SSH_KEY_PASSPHRASE=
