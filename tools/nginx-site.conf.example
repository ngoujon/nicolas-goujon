# =============================================================================
# Configuration nginx à AJOUTER (ne pas remplacer les configs existantes)
# Copier ce fichier dans /etc/nginx/sites-available/ ou /etc/nginx/conf.d/
# Puis: sudo ln -s /etc/nginx/sites-available/nicolas-goujon.conf /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
# Puis pour HTTPS (avec www) :
#       certbot --nginx --expand -d nicolas-goujon.fr -d www.nicolas-goujon.fr
# =============================================================================

server {
    listen 80;
    server_name nicolas-goujon.fr www.nicolas-goujon.fr;

    # Ne pas divulguer la version de nginx dans l'en-tête `Server`
    # (le défaut Ubuntu est `server_tokens build`, qui l'expose).
    # Directive volontairement placée dans ce bloc : elle ne modifie pas les
    # autres sites hébergés sur la même machine.
    server_tokens off;

    # Les en-têtes de sécurité (CSP, HSTS, X-Frame-Options, nosniff...) sont
    # posés par le nginx du conteneur (voir nginx.conf + nginx-security-headers.conf
    # à la racine du dépôt) et traversent ce proxy tels quels. Ne pas les
    # redéclarer ici : des en-têtes en double sont ignorés par certains
    # navigateurs, qui n'appliquent alors plus aucune protection.

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
