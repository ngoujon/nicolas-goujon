# =============================================================================
# CONFIGURATION ENVIRONNEMENT - Nicolas GOUJON
# =============================================================================
# Copier les sections dans les bons fichiers :
#   - Variables "Frontend" → .env (à la racine)
#   - Variables "API Laravel" → api/.env (pour dev local) ou .env (pour Docker)
#   - Pour Docker : à la racine, remplir les variables utilisées par docker-compose
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (.env à la racine)
# -----------------------------------------------------------------------------
PORT=3000

# URL de l’API contact. En dev local avec Laravel sur 8000 :
REACT_APP_CONTACT_API_URL=http://localhost:8000/api/contact
# Avec Docker (même domaine) : laisser vide pour utiliser /api/contact en relatif
# REACT_APP_CONTACT_API_URL=


# -----------------------------------------------------------------------------
# API Laravel – dev local (api/.env, copier depuis api/.env.example)
# -----------------------------------------------------------------------------
# Clé Laravel (générer avec : cd api && php artisan key:generate --show)
APP_KEY=

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@nicolas-goujon.fr
MAIL_FROM_NAME="Site Nicolas Goujon"
CONTACT_EMAIL_TO=contact@nicolas-goujon.fr


# -----------------------------------------------------------------------------
# Docker (variables à la racine pour docker-compose, utilisées par le service api)
# -----------------------------------------------------------------------------
APP_KEY=
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@nicolas-goujon.fr
MAIL_FROM_NAME="Site Nicolas Goujon"
CONTACT_EMAIL_TO=contact@nicolas-goujon.fr
