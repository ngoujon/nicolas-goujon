# =============================================================================
# CONFIGURATION ENVIRONNEMENT - Nicolas GOUJON
# =============================================================================
# Copier les sections dans les bons fichiers :
#   - Variables "Frontend" → .env (à la racine du projet)
#   - Variables "Serveur API contact" → server/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (.env à la racine)
# -----------------------------------------------------------------------------
# Port du serveur de dev React
PORT=3000

# URL de l’API contact. En local (avec le serveur lancé) :
REACT_APP_CONTACT_API_URL=http://localhost:3030/api/contact
# En production, mettre l’URL réelle de ton API, ex. :
# REACT_APP_CONTACT_API_URL=https://api.monsite.com/api/contact


# -----------------------------------------------------------------------------
# Serveur API contact (server/.env)
# -----------------------------------------------------------------------------
# Port du serveur API (optionnel, défaut 3030)
SERVER_PORT=3030

# SMTP – serveur d’envoi des emails (formulaire de contact)
# Exemples : Brevo → smtp-relay.brevo.com | Gmail → smtp.gmail.com | OVH → ssl0.ovh.net
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-utilisateur-smtp
SMTP_PASS=votre-mot-de-passe-smtp

# Adresse affichée comme expéditeur (guillemets si le nom contient un espace)
MAIL_FROM="Site Nicolas Goujon <noreply@votredomaine.com>"

# Adresse qui reçoit les messages du formulaire (la tienne)
CONTACT_EMAIL_TO=contact@nicolas-goujon.fr
