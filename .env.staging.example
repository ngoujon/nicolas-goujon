# Environnement STAGING — copier en « .env » dans le répertoire staging dédié
# sur le VPS (ex: /home/nicolas-goujon/nicolas-goujon-staging), distinct du
# répertoire de production. Ne jamais réutiliser le .env de production ici.

# Force tools/deploy.sh à utiliser docker-compose.staging.yml (conteneurs,
# port et nom distincts de la prod)
DEPLOY_ENV=staging

# Port exposé pour le staging (différent du port de prod, ex: 3001)
PORT=3002

APP_KEY=

# Mail — en staging, garder MailHog par défaut pour ne jamais envoyer de vrais
# emails aux utilisateurs. Ne pointer vers le SMTP réel que si un test d'envoi
# est volontairement nécessaire.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@nicolas-goujon.fr
MAIL_FROM_NAME="Site Nicolas Goujon (staging)"
CONTACT_EMAIL_TO=contact@nicolas-goujon.fr
