# Port du serveur de dev (Create React App)
PORT=3000

# URL de l’API contact (serveur SMTP). En local : http://localhost:3030/api/contact
REACT_APP_CONTACT_API_URL=http://localhost:3030/api/contact

# Mail — dev : lance avec « docker compose --profile dev up » pour MailHog. Prod : mets ton SMTP (MAIL_HOST, etc.).
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@nicolas-goujon.fr
MAIL_FROM_NAME="Site Nicolas Goujon"
CONTACT_EMAIL_TO=contact@nicolas-goujon.fr
