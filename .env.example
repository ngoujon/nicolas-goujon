# =============================================================================
# Variables d'environnement à la racine (copier vers .env)
# Utilisées par le frontend React (dev) et par docker-compose (service api).
# Pour lancer l'API Laravel seule en local, voir api/.env.example.
# =============================================================================

# --- Frontend -----------------------------------------------------------------
# Port du serveur de dev (Create React App) / port exposé par Docker
PORT=3000

# URL de l'API contact. En dev local avec `php artisan serve` (port 8000) :
REACT_APP_CONTACT_API_URL=http://localhost:8000/api/contact
# Avec Docker (même domaine) : laisser vide pour utiliser /api/contact en relatif
# REACT_APP_CONTACT_API_URL=

# --- API Laravel (Docker) -----------------------------------------------------
# Clé Laravel (générer avec : cd api && php artisan key:generate --show)
APP_KEY=

# Dev : lancer « docker compose --profile dev up » pour MailHog.
# Prod : renseigner le SMTP réel (MAIL_HOST, MAIL_PORT, identifiants, chiffrement).
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@nicolas-goujon.fr
MAIL_FROM_NAME="Site Nicolas Goujon"
CONTACT_EMAIL_TO=contact@nicolas-goujon.fr
