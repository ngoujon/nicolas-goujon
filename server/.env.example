# Port du serveur API contact (défaut: 3030)
SERVER_PORT=3030

# SMTP - Serveur d'envoi (ex: Gmail, Brevo, OVH, SendGrid)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-utilisateur-smtp
SMTP_PASS=votre-mot-de-passe-smtp

# Adresse qui apparaît comme expéditeur (ex: "Site Nicolas Goujon <noreply@votredomaine.com>")
MAIL_FROM="Site Nicolas Goujon <noreply@votredomaine.com>"

# Adresse où recevoir les messages du formulaire (la tienne)
CONTACT_EMAIL_TO=contact@nicolas-goujon.fr
